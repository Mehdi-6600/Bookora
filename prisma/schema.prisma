generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USER (Business Owner - via Telegram)
// ============================================
model User {
  id              String   @id @default(cuid())
  telegramId      String   @unique
  telegramUsername String?
  firstName       String?
  lastName        String?
  languageCode    String?  @default("en")
  isAdmin         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  businesses      Business[]
  subscriptions   Subscription[]

  @@index([telegramId])
  @@map("users")
}

// ============================================
// BUSINESS
// ============================================
model Business {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  slug        String   @unique
  description String?
  logo        String?
  coverImage  String?
  phone       String?
  email       String?
  website     String?
  instagram   String?
  whatsapp    String?
  address     String?
  country     String?
  city        String?
  timezone    String   @default("UTC")
  currency    String   @default("EUR")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  services        Service[]
  workingHours    WorkingHour[]
  timeOffs        TimeOff[]
  bookings        Booking[]
  specialOffers   SpecialOffer[]
  subscriptions   Subscription[]
  paymentMethods  PaymentMethod[]

  @@index([ownerId])
  @@index([slug])
  @@index([status])
  @@map("businesses")
}

// ============================================
// SERVICE
// ============================================
model Service {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  currency        String   @default("EUR")
  durationMinutes Int
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([businessId])
  @@index([active])
  @@map("services")
}

// ============================================
// WORKING HOURS
// ============================================
model WorkingHour {
  id          String   @id @default(cuid())
  businessId  String
  dayOfWeek   Int
  enabled     Boolean  @default(true)
  openTime    String
  closeTime   String
  breakStart  String?
  breakEnd    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
  @@map("working_hours")
}

// ============================================
// TIME OFF
// ============================================
model TimeOff {
  id          String   @id @default(cuid())
  businessId  String
  startAt     DateTime
  endAt       DateTime
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([startAt, endAt])
  @@map("time_offs")
}

// ============================================
// BOOKING
// ============================================
model Booking {
  id                String    @id @default(cuid())
  businessId        String
  serviceId         String
  customerName      String
  customerPhone     String
  customerEmail     String?
  startAt           DateTime
  endAt             DateTime
  timezone          String
  status            String    @default("PENDING_PAYMENT")
  servicePrice      Decimal   @db.Decimal(10, 2)
  discountAmount    Decimal   @default(0) @db.Decimal(10, 2)
  finalPrice        Decimal   @db.Decimal(10, 2)
  depositType       String    @default("NONE")
  depositValue      Decimal   @default(0) @db.Decimal(10, 2)
  depositDue        Decimal   @default(0) @db.Decimal(10, 2)
  depositPaid       Decimal   @default(0) @db.Decimal(10, 2)
  remainingAmount   Decimal   @default(0) @db.Decimal(10, 2)
  currency          String    @default("EUR")
  paymentStatus     String    @default("PENDING")
  specialOfferId    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  cancelledAt       DateTime?
  completedAt       DateTime?

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  specialOffer SpecialOffer? @relation(fields: [specialOfferId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([businessId])
  @@index([serviceId])
  @@index([startAt, endAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([customerPhone])
  @@map("bookings")
}

// ============================================
// PAYMENT
// ============================================
model Payment {
  id                    String    @id @default(cuid())
  bookingId             String
  type                  String
  amount                Decimal   @db.Decimal(10, 2)
  currency              String    @default("EUR")
  status                String    @default("PENDING")
  method                String?
  receiptUrl            String?
  transactionReference  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  verifiedAt            DateTime?
  rejectedAt            DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

// ============================================
// SPECIAL OFFER
// ============================================
model SpecialOffer {
  id                    String    @id @default(cuid())
  businessId            String
  name                  String
  description           String?
  discountType          String
  discountValue         Decimal   @db.Decimal(10, 2)
  appliesToAllServices  Boolean   @default(true)
  startAt               DateTime
  endAt                 DateTime
  usageLimit            Int?
  usageCount            Int       @default(0)
  couponCode            String?
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([businessId])
  @@index([couponCode])
  @@index([active])
  @@map("special_offers")
}

// ============================================
// PAYMENT METHOD (Business's own payment info)
// ============================================
model PaymentMethod {
  id            String   @id @default(cuid())
  businessId    String
  type          String
  accountHolder String?
  bankName      String?
  cardNumber    String?
  accountNumber String?
  iban          String?
  instructions  String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("payment_methods")
}

// ============================================
// SUBSCRIPTION (Bookora's own subscription)
// ============================================
model Subscription {
  id                String    @id @default(cuid())
  userId            String
  businessId        String?
  plan              String    @default("FREE")
  status            String    @default("ACTIVE")
  provider          String
  providerPaymentId String?
  receiptReference  String?
  receiptNote       String?
  adminNote         String?
  reviewedAt        DateTime?
  startedAt         DateTime  @default(now())
  expiresAt         DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([businessId])
  @@index([status])
  @@map("subscriptions")
}

// ============================================
// ADMIN SETTING (Bookora's manual payment info for Iran)
// ============================================
model AdminSetting {
  id            String   @id @default(cuid())
  key           String   @unique
  value         String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([key])
  @@map("admin_settings")
}
