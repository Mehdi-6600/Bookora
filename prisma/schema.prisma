generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String   @id @default(cuid())
  telegramId        String   @unique
  telegramUsername  String?
  firstName         String?
  lastName          String?
  languageCode      String?  @default("en")
  isAdmin           Boolean  @default(false)
  paymentPreference String   @default("AUTO")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  businesses    Business[]
  subscriptions Subscription[]

  @@index([telegramId])
  @@map("users")
}

model Business {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  slug        String   @unique
  description String?
  logo        String?
  coverImage  String?
  phone       String?
  email       String?
  website     String?
  instagram   String?
  whatsapp    String?
  address     String?
  country     String?
  city        String?
  timezone    String   @default("UTC")
  currency    String   @default("EUR")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  services       Service[]
  workingHours   WorkingHour[]
  timeOffs       TimeOff[]
  bookings       Booking[]
  specialOffers  SpecialOffer[]
  subscriptions  Subscription[]
  paymentMethods PaymentMethod[]

  @@index([ownerId])
  @@index([slug])
  @@index([status])
  @@map("businesses")
}

model Service {
  id                  String   @id @default(cuid())
  businessId          String
  name                String
  description         String?
  price               Decimal  @db.Decimal(10, 2)
  currency            String   @default("EUR")
  durationMinutes     Int
  slotIntervalMinutes Int      @default(30)
  active              Boolean  @default(true)
  sortOrder           Int      @default(0)
  depositType         String   @default("NONE")
  depositValue        Decimal  @default(0) @db.Decimal(10, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([businessId])
  @@index([active])
  @@map("services")
}

model WorkingHour {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int
  enabled    Boolean  @default(true)
  openTime   String
  closeTime  String
  breakStart String?
  breakEnd   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
  @@map("working_hours")
}

model TimeOff {
  id         String   @id @default(cuid())
  businessId String
  startAt    DateTime
  endAt      DateTime
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([startAt, endAt])
  @@map("time_offs")
}

model Booking {
  id              String    @id @default(cuid())
  businessId      String
  serviceId       String
  customerName    String
  customerPhone   String
  customerEmail   String?
  startAt         DateTime
  endAt           DateTime
  timezone        String
  status          String    @default("PENDING_PAYMENT")
  servicePrice    Decimal   @db.Decimal(10, 2)
  discountAmount  Decimal   @default(0) @db.Decimal(10, 2)
  finalPrice      Decimal   @db.Decimal(10, 2)
  depositType     String    @default("NONE")
  depositValue    Decimal   @default(0) @db.Decimal(10, 2)
  depositDue      Decimal   @default(0) @db.Decimal(10, 2)
  depositPaid     Decimal   @default(0) @db.Decimal(10, 2)
  remainingAmount Decimal   @default(0) @db.Decimal(10, 2)
  currency        String    @default("EUR")
  paymentStatus   String    @default("PENDING")
  specialOfferId  String?
  receiptToken    String?   @unique
  idempotencyKey  String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  cancelledAt     DateTime?
  completedAt     DateTime?

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  specialOffer SpecialOffer? @relation(fields: [specialOfferId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([businessId])
  @@index([serviceId])
  @@index([startAt, endAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([customerPhone])
  @@map("bookings")
}

model Payment {
  id                   String    @id @default(cuid())
  bookingId            String
  type                 String
  amount               Decimal   @db.Decimal(10, 2)
  currency             String    @default("EUR")
  status               String    @default("PENDING")
  method               String?
  receiptUrl           String?
  transactionReference String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  verifiedAt           DateTime?
  rejectedAt           DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model SpecialOffer {
  id                   String   @id @default(cuid())
  businessId           String
  name                 String
  description          String?
  discountType         String
  discountValue        Decimal  @db.Decimal(10, 2)
  appliesToAllServices Boolean  @default(true)
  startAt              DateTime
  endAt                DateTime
  usageLimit           Int?
  usageCount           Int      @default(0)
  couponCode           String?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([businessId])
  @@index([couponCode])
  @@index([active])
  @@map("special_offers")
}

model PaymentMethod {
  id            String   @id @default(cuid())
  businessId    String
  type          String
  accountHolder String?
  bankName      String?
  cardNumber    String?
  accountNumber String?
  iban          String?
  instructions  String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("payment_methods")
}

model Subscription {
  id                String    @id @default(cuid())
  userId            String
  businessId        String?
  plan              String    @default("FREE")
  status            String    @default("ACTIVE")
  provider          String
  providerPaymentId String?   @unique
  receiptReference  String?
  receiptNote       String?
  adminNote         String?
  reviewedAt        DateTime?
  startedAt         DateTime  @default(now())
  expiresAt         DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([businessId])
  @@index([status])
  @@map("subscriptions")
}

model AdminSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@map("admin_settings")
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(1)
  expiresAt DateTime

  @@index([key])
  @@index([expiresAt])
  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// Growth / customer-acquisition models (PHASE 8 + PHASE 9)
//
// These tables store only PUBLIC business information that an administrator
// deliberately enters or that an explicitly configured, authorized source
// returns. No private contact data, no credentials and no scraped personal
// data are stored here.
// ---------------------------------------------------------------------------

model OutreachCampaign {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)

  /// DRAFT -> REVIEW -> APPROVED -> SENDING -> COMPLETED / FAILED
  status       String   @default("DRAFT")
  /// Approved market scope: TEHRAN | MASHHAD | SHIRAZ | KARAJ
  cities       String[] @default([])
  /// MENS_BARBER | WOMENS_SALON
  segments     String[] @default([])
  language     String   @default("fa")
  objective    String?
  templateId   String?
  cta          String?
  destinationUrl String?
  /// ONE_FOLLOWUP | NO_FOLLOWUP
  followUpPolicy String @default("ONE_FOLLOWUP")
  /// TELEGRAM_BOT | MANUAL
  channel      String   @default("TELEGRAM_BOT")
  sendLimit    Int?
  requestedById String?
  approvedById  String?
  approvedAt    DateTime?
  lastDryRunAt  DateTime?
  lastPreparedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template   InvitationTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  prospects  OutreachProspect[]
  botStarts  BotStart[]
  invitations OutreachInvitation[]

  @@index([active])
  @@index([status])
  @@index([templateId])
  @@map("outreach_campaigns")
}

model OutreachProspect {
  id          String    @id @default(cuid())
  publicName  String
  category    String    @default("OTHER")
  /// Approved city code: TEHRAN | MASHHAD | SHIRAZ | KARAJ. Never free text.
  city        String?
  /// MENS_BARBER | WOMENS_SALON
  segment     String?
  neighborhood String?
  country     String?
  language    String    @default("en")
  publicUrl   String?
  telegramUsername String?
  sourceUrl   String?
  sourceName  String?
  dedupeKey   String    @unique
  status      String    @default("NEW")

  /// DISCOVERED | VERIFIED | REJECTED. A discovery hit is not a prospect.
  verificationStatus     String    @default("DISCOVERED")
  verificationDate       DateTime?
  /// HIGH | MEDIUM | LOW
  verificationConfidence String?
  verificationEvidence   String?
  /// HIGH | MEDIUM | LOW - potential relevance of online booking
  bookingRelevance       String?
  /// ELIGIBLE | MANUAL_ONLY | NOT_ELIGIBLE | BLOCKED, from the last check
  outreachEligibility    String?

  notes       String?
  nextFollowUpAt   DateTime?
  lastContactedAt  DateTime?
  lastInteractionAt DateTime?
  contactedCount   Int      @default(0)
  optedOutAt  DateTime?
  campaignId  String?
  convertedUserId       String?
  convertedBusinessId   String?
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaign    OutreachCampaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  invitations OutreachInvitation[]
  botStarts   BotStart[]
  candidates  DiscoveryCandidate[]

  @@index([status])
  @@index([campaignId])
  @@index([nextFollowUpAt])
  @@index([category])
  @@index([optedOutAt])
  @@index([city])
  @@index([segment])
  @@index([verificationStatus])
  @@index([city, segment])
  @@map("outreach_prospects")
}

model InvitationTemplate {
  id        String   @id @default(cuid())
  code      String   @unique
  campaigns OutreachCampaign[]
  language  String   @default("en")
  category  String   @default("ALL")
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitations OutreachInvitation[]

  @@index([language])
  @@index([active])
  @@map("invitation_templates")
}

model OutreachInvitation {
  id             String    @id @default(cuid())
  prospectId     String
  templateId     String?
  campaignId     String?
  campaign       OutreachCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  channel        String    @default("TELEGRAM")
  language       String    @default("en")
  body           String
  deepLink       String
  startParam     String    @unique
  status         String    @default("DRAFT")
  approvedAt     DateTime?
  approvedByUserId String?
  reviewedAt     DateTime?
  rejectionNote  String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  failureReason  String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  prospect OutreachProspect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  template InvitationTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([prospectId])
  @@index([campaignId])
  @@index([createdAt])
  @@map("outreach_invitations")
}

/// One row per /start (or Mini App launch with a start parameter).
/// Used for attribution only — no message content is stored.
model BotStart {
  id               String   @id @default(cuid())
  telegramId       String
  userId           String?
  startParam       String?
  prospectId       String?
  campaignId       String?
  wasExistingUser  Boolean  @default(false)
  createdAt        DateTime @default(now())

  prospect OutreachProspect?  @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  campaign OutreachCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([telegramId])
  @@index([startParam])
  @@index([createdAt])
  @@map("bot_starts")
}

/// Do-not-contact / opt-out suppression list.
model OutreachSuppression {
  id        String   @id @default(cuid())
  identifier String  @unique
  reason    String   @default("OPT_OUT")
  note      String?
  createdAt DateTime @default(now())

  @@index([reason])
  @@map("outreach_suppressions")
}

model DiscoveryKeyword {
  id        String   @id @default(cuid())
  term      String
  group     String
  language  String   @default("en")
  priority  Int      @default(1)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([group, language, term])
  @@index([enabled])
  @@index([group])
  @@map("discovery_keywords")
}

model DiscoveryCandidate {
  id           String    @id @default(cuid())
  publicName   String
  publicUrl    String?
  description  String?
  source       String
  sourceRef    String?
  group        String
  matchedTerms String    @default("")
  score        Int       @default(0)
  city         String?
  language     String    @default("en")
  dedupeKey    String    @unique
  status       String    @default("NEW")
  discoveredOn DateTime
  reviewNote   String?
  prospectId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  prospect OutreachProspect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([discoveredOn])
  @@index([group])
  @@index([score])
  @@map("discovery_candidates")
}

/// One row per scheduled daily run. `runDate` is unique so a retry (or a
/// double trigger from the scheduler) cannot execute the job twice.
model DiscoveryRun {
  id                 String    @id @default(cuid())
  runDate            String    @unique
  timezone           String    @default("UTC")
  status             String    @default("RUNNING")
  discovered         Int       @default(0)
  matched            Int       @default(0)
  duplicates         Int       @default(0)
  excluded           Int       @default(0)
  invitationsPrepared Int      @default(0)
  messagesSent       Int       @default(0)
  messagesDelivered  Int       @default(0)
  botStarts          Int       @default(0)
  registrations      Int       @default(0)
  activations        Int       @default(0)
  firstBookings      Int       @default(0)
  error              String?
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?

  @@index([startedAt])
  @@map("discovery_runs")
}

/// Privacy-conscious acquisition funnel.
/// `anonId` is a server-side hash of (IP + user-agent + rotating daily salt).
/// No raw IP, no user agent string, no Telegram payload and no personal data
/// are ever written to this table.
model FunnelEvent {
  id        String   @id @default(cuid())
  event     String
  anonId    String
  locale    String?
  ref       String?
  /// Campaign code when the visit came from an attributed campaign link.
  campaignId String?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
  @@index([campaignId])
  @@map("funnel_events")
}

/// Audit trail of important outreach state changes (approvals, message edits,
/// pause toggles). Purely additive: until `npm run db:push` (or the equivalent
/// SQL file) has been applied on production, this table simply does not exist
/// and every read/write degrades gracefully — see src/lib/outreach/audit.ts.
model OutreachAuditEvent {
  id String @id @default(cuid())
  /// What was changed: "campaign" | "message" | "settings" | "cities" | "invitation"
  scope       String
  /// Row id (campaign id, etc.) when applicable.
  entityId    String?
  /// Stable, machine-readable action name, e.g. "campaign.approved".
  action      String
  actorUserId String?
  /// Short, safe summary. Never message bodies, contacts, secrets or tokens.
  detail      String?
  createdAt   DateTime @default(now())

  @@index([scope, entityId])
  @@index([createdAt])
  @@map("outreach_audit_events")
}
