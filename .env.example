# ============================================
# Bookora Environment Variables
# ============================================

# --------------------------------------------
# Neon PostgreSQL
# --------------------------------------------
DATABASE_URL=""
DIRECT_URL=""

# --------------------------------------------
# Telegram
# --------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Set to a random secret of at least 32 characters before configuring Telegram webhooks.
TELEGRAM_WEBHOOK_SECRET=""

# Set to a separate random secret of at least 32 characters for scheduled expiry jobs.
CRON_SECRET=""

# --------------------------------------------
# Application
# --------------------------------------------
APP_URL=""
BOT_USERNAME=""
JWT_SECRET=""
# Optional comma-separated allowlist; if set, it is authoritative (including an empty list).
# ADMIN_TELEGRAM_IDS="123456789,987654321"

# --------------------------------------------
# Optional (اگر در frontend استفاده می‌شود)
# --------------------------------------------
NEXT_PUBLIC_APP_URL=""
NEXT_PUBLIC_BOT_USERNAME=""
